{
  "compilerOptions": {
    "strictNullChecks": true,
    "noImplicitAny": true,
    "module": "CommonJS",
    "target": "ES2018",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "strictPropertyInitialization": true,
    "lib": [
      "ES2020"
    ],
    "typeRoots": [
      "./node_modules"
    ],
    "types": [
      "miniprogram-api-typings"
    ],
    "skipLibCheck": true
  },
  "include": [
    "miniprogram/**/*.ts",
    "typings/index.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
