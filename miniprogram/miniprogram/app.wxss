page {
  --bg:#f6f7f8; --surface:#ffffff; --soft:#eef0f2; --text:#202326;
  --muted:#737982; --line:#e5e7ea; --accent:#315e4e; --on-accent:#ffffff;
  --danger:#b34740; --shadow:0 4rpx 20rpx rgba(25,32,42,.035);
  background:var(--bg); color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;
  font-size:28rpx; line-height:1.6;
}
@media (prefers-color-scheme:dark) {
  page { --bg:#191a1c; --surface:#242628; --soft:#2d3033; --text:#eff0f2;
    --muted:#a5abb2; --line:#363a3e; --accent:#abd0ba; --on-accent:#172a20;
    --danger:#f0a19a; --shadow:none; }
  .brand-image { filter:invert(1) hue-rotate(180deg); }
}
view,button,input,textarea,text,scroll-view { box-sizing:border-box; }
button { margin:0; min-height:88rpx; font-size:28rpx; line-height:1.4; border-radius:20rpx;
  color:var(--text); background:var(--surface); padding:24rpx 28rpx; font-weight:500; }
button::after { border:0; }
button[disabled] { opacity:.48; color:var(--muted); background:var(--soft); }
button.primary { background:var(--accent); color:var(--on-accent); }
button.primary[disabled] { opacity:.5; }
button.quiet { background:transparent; padding:20rpx 18rpx; }
button.danger { color:var(--danger); }
.tap { opacity:.65; }
.page { padding:28rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); }
.page-header { margin:4rpx 0 28rpx; }
.title { font-size:44rpx; line-height:1.3; letter-spacing:-1rpx; font-weight:650; margin:0 0 12rpx; overflow-wrap:break-word; }
.subtitle,.muted { color:var(--muted); }
.subtitle { font-size:26rpx; line-height:1.65; margin:0 0 28rpx; }
.page-header .subtitle { margin:0; }
.eyebrow { font-size:22rpx; color:var(--muted); margin-bottom:12rpx; }
.card { border:1rpx solid var(--line); background:var(--surface); border-radius:26rpx;
  padding:28rpx; margin-bottom:24rpx; box-shadow:var(--shadow); }
.row { display:flex; align-items:center; gap:20rpx; }
.between { justify-content:space-between; }
.grow { flex:1; min-width:0; }
.section-title { font-size:31rpx; font-weight:600; margin:32rpx 0 18rpx; }
.card>.section-title:first-child { margin-top:0; }
.section-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin:22rpx 0 10rpx; }
.section-heading .section-title { margin:0; }
.section-heading button { flex:none; }
.label { display:block; font-size:26rpx; font-weight:500; margin:24rpx 0 12rpx; }
.field { width:100%; min-height:92rpx; height:92rpx; padding:22rpx 24rpx; border-radius:18rpx;
  background:var(--soft); color:var(--text); font-size:28rpx; }
.textarea { width:100%; min-height:260rpx; height:300rpx; padding:22rpx 24rpx; border-radius:18rpx;
  background:var(--soft); color:var(--text); font-size:28rpx; line-height:1.7; }
.picker { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:22rpx 24rpx;
  background:var(--soft); border-radius:18rpx; min-height:92rpx; word-break:break-word; }
.chevron { flex:none; width:13rpx; height:13rpx; border-top:2rpx solid var(--muted); border-right:2rpx solid var(--muted); transform:rotate(45deg); margin-right:5rpx; }
.chevron.down { transform:rotate(135deg); margin-top:-7rpx; }
.small { font-size:24rpx; }
.error { padding:22rpx 24rpx; background:var(--surface); border:1rpx solid var(--line); border-radius:18rpx; color:var(--danger); margin:20rpx 0; }
.empty { text-align:center; padding:64rpx 28rpx; color:var(--muted); font-size:26rpx; }
.empty-title { color:var(--text); font-size:31rpx; font-weight:600; margin-bottom:12rpx; }
.empty-symbol { width:88rpx; height:88rpx; display:flex; align-items:center; justify-content:center; margin:0 auto 24rpx;
  border-radius:24rpx; background:var(--soft); color:var(--muted); font-size:36rpx; }
.tag { display:inline-block; padding:8rpx 16rpx; margin:8rpx 10rpx 0 0; background:var(--soft); border-radius:12rpx; font-size:24rpx; }
.actions { display:flex; gap:16rpx; margin-top:28rpx; }
.actions button { flex:1; min-width:0; }
.list-row { padding:24rpx 0; border-bottom:1rpx solid var(--line); }
.list-row:last-child { border-bottom:0; }
.text-content { white-space:pre-wrap; word-break:break-word; line-height:1.85; }
.brand-lockup { width:340rpx; height:92rpx; position:relative; overflow:hidden; }
.brand-image { position:absolute; width:125%; height:142rpx; left:-12.5%; top:50%; transform:translateY(-50%); }
.loading-dot { display:inline-block; width:13rpx; height:13rpx; border-radius:50%; background:var(--accent); margin-right:14rpx; animation:pulse 1.3s ease-in-out infinite; }
@keyframes pulse { 50% { opacity:.25; } }
.badge { color:var(--accent); font-size:23rpx; }
.spacer { height:24rpx; }
.rule-line { margin:12rpx 0; }
.pill-row,.segmented { display:flex; gap:8rpx; padding:7rpx; margin:20rpx 0; border-radius:21rpx; background:var(--soft); }
.pill,.segment { flex:1; min-width:0; min-height:80rpx; padding:20rpx 10rpx; border-radius:15rpx;
  background:transparent; color:var(--muted); text-align:center; font-size:26rpx; font-weight:500; }
.pill.active,.segment.active { background:var(--surface); box-shadow:0 3rpx 10rpx rgba(0,0,0,.07); color:var(--text); }
@media (min-width:600px) { .page { max-width:900rpx; margin:0 auto; } }
@media (prefers-reduced-motion:reduce) { .loading-dot,.progress-indeterminate { animation:none; } }

/* Keep touch targets usable on 320 px devices as well as larger phones. */
button,.pill,.segment{min-height:44px}
.section-heading button{width:auto;margin:0}
.actions button{width:0}
