<view class="chat-page"><view class="chat-toolbar row between"><view class="chat-heading">对话</view><view class="row"><button class="quiet small" bindtap="toggleHistory" disabled="{{sending}}">历史</button><button class="quiet small" bindtap="newChat" disabled="{{sending}}">新对话</button></view></view><view wx:if="{{historyOpen}}" class="history-panel"><view class="muted small">最近对话</view><view wx:for="{{conversations}}" wx:key="id" class="list-row history-row"><button class="history-title" data-id="{{item.id}}" bindtap="openConversation" hover-class="tap">{{item.pinned?'置顶 · ':''}}{{item.title}}</button><button class="quiet history-manage" data-id="{{item.id}}" bindtap="manageConversation">管理</button></view><view wx:if="{{!conversations.length}}" class="empty">还没有历史对话</view></view><scroll-view scroll-y class="messages" scroll-into-view="{{scrollTo}}" scroll-with-animation="{{false}}"><view wx:if="{{!messages.length&&!conversationId}}" class="welcome"><view class="eyebrow">简面职说 · 你的求职搭子</view><view class="title">你好，{{username}}</view><view class="subtitle">简历怎么写，面试怎么说。</view></view><button wx:if="{{canLoadMore}}" class="quiet small" bindtap="loadMore" loading="{{loadingHistory}}">加载更多历史</button><view wx:for="{{messages}}" wx:key="index" class="message {{item.role==='user'?'user':'assistant'}}"><view wx:if="{{item.role==='assistant'}}" class="message-name">简面职说 {{item.incomplete?'· 回复已中断':''}}</view><rich-text wx:if="{{item.role==='assistant'&&item.content}}" nodes="{{item.html}}" user-select/><text wx:elif="{{item.content}}" class="text-content" selectable>{{item.content}}</text><view wx:elif="{{sending}}" class="muted small"><view class="loading-dot"/>正在组织回复</view></view><view wx:if="{{error}}" class="error">{{error}}<view class="small">历史记录会保存已接收的内容，请先核对再发起下一次提问。</view></view><view id="chat-bottom" class="bottom-space"/></scroll-view><view class="composer-wrap">
  <view class="composer">
    <textarea class="composer-input" value="{{draft}}" bindinput="input" maxlength="{{maxChars}}" auto-height fixed cursor-spacing="16" placeholder="聊聊你的求职想法…" placeholder-class="composer-placeholder" disabled="{{sending}}"/>
    <view class="composer-action-slot">
      <button wx:if="{{sending}}" size="mini" class="composer-action" style="width:44px;height:44px;min-width:44px;min-height:44px;max-width:44px;padding:0;margin:0;background:transparent;" bindtap="stop" aria-label="停止生成" hover-class="composer-pressed">
        <view class="send-face is-stopping"><view class="stop-icon"/></view>
      </button>
      <button wx:else size="mini" class="composer-action" style="width:44px;height:44px;min-width:44px;min-height:44px;max-width:44px;padding:0;margin:0;background:transparent;" bindtap="send" disabled="{{!draft||loadingHistory}}" aria-label="发送消息" hover-class="composer-pressed">
        <view class="send-face"><view class="send-arrow"><view class="arrow-stem"/><view class="arrow-head"/></view></view>
      </button>
    </view>
  </view>
</view></view>
