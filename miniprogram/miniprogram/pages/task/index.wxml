<view class="page"><view class="eyebrow">你的求职准备</view><view class="title">{{kind==='match'||kind==='resume'?'岗位匹配':kind==='interview'?'面试准备':'学习计划'}}</view><view wx:if="{{status==='running'||status==='queued'}}" class="card"><view><view class="loading-dot"/>{{message||'正在生成，请稍候'}}</view><view class="muted small">已等待 {{elapsed}} 秒 · 可以暂时离开，稍后查看历史。</view><view class="progress-track"><view class="progress-indeterminate"/></view><button wx:if="{{jobId}}" class="quiet small" bindtap="stop">停止任务</button></view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error||status==='running'}}" class="quiet" bindtap="refresh">刷新任务状态</button><block wx:if="{{report}}"><view class="card score-card"><view class="muted">{{report.job_analysis.job_title||'匹配结果'}}</view><view class="score">{{report.total_score}}<text> / 100</text></view><view>{{report.match_level}}</view><view class="score-grid"><view wx:for="{{scoreRows}}" wx:key="label"><view class="muted small">{{item.label}}</view><view class="score-value">{{item.value}}</view></view></view></view><view class="card"><view class="section-title">技能匹配</view><view wx:for="{{report.matched_skills}}" wx:key="*this" class="tag">{{item}}</view><view class="section-title">需要补齐</view><view wx:for="{{report.missing_skills}}" wx:key="*this" class="tag">{{item}}</view><view wx:if="{{!report.missing_skills.length}}" class="muted">暂无明确技能缺口</view></view><view wx:if="{{report.strengths.length}}" class="card"><view class="section-title">你的优势</view><view wx:for="{{report.strengths}}" wx:key="index" class="list-row text-content">{{item}}</view></view><view wx:if="{{report.risks.length}}" class="card"><view class="section-title">需要留意</view><view wx:for="{{report.risks}}" wx:key="index" class="list-row text-content">{{item}}</view></view><view wx:if="{{report.suggestions.length}}" class="card"><view class="section-title">下一步建议</view><view wx:for="{{report.suggestions}}" wx:key="index" class="list-row text-content">{{item}}</view></view><view wx:if="{{report.verification}}" class="card"><view class="small muted">报告核对 · {{report.verification.summary}}</view></view></block><view wx:if="{{status==='paused'}}" class="card"><view class="section-title">请你确认一下</view><view class="muted small">{{message||'请核对报告，确认后继续，或填写需要修正的事实。'}}</view><textarea class="textarea feedback" value="{{feedback}}" bindinput="input" maxlength="2000" placeholder="例如：请根据简历项目经历重新核对技能匹配，并说明缺少的证据。留空表示接受当前报告。"/><view class="muted small">填写意见后会重新生成并校验；留空提交表示人工接受当前报告，原有校验提示仍会保留。</view><button class="primary" bindtap="resume" loading="{{submitting}}" disabled="{{submitting}}">提交审核</button></view><view wx:if="{{status==='completed'&&report}}" class="actions"><button bindtap="plan" data-kind="interview">准备面试</button><button class="primary" bindtap="plan" data-kind="learning">规划学习</button></view><block wx:if="{{questions.length}}"><view class="subtitle">{{planTitle}}</view><view class="card"><view class="section-title">重点方向</view><view wx:for="{{focusAreas}}" wx:key="*this" class="tag">{{item}}</view></view><view wx:for="{{questions}}" wx:key="index" class="card"><view class="question-number">问题 {{index+1}}</view><view class="section-title">{{item.question}}</view><view class="muted small">{{item.purpose}}</view><view class="label">回答要点</view><view wx:for="{{item.answer_points}}" wx:for-item="point" wx:key="index" class="list-row text-content">{{point}}</view></view></block><block wx:if="{{learningItems.length}}"><view class="subtitle">{{planTitle}}</view><view class="card text-content">{{planSummary}}</view><view wx:for="{{learningItems}}" wx:key="index" class="card"><view class="row between"><view class="section-title">{{item.skill}}</view><text class="badge">约 {{item.estimated_days}} 天</text></view><view class="muted small">{{item.reason}}</view><view wx:for="{{item.tasks}}" wx:for-item="task" wx:key="index" class="list-row text-content">{{task}}</view></view><view class="card"><view class="section-title">每周安排</view><view wx:for="{{weeklyPlan}}" wx:key="index" class="list-row text-content">{{item}}</view></view></block></view>
