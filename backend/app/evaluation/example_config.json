{
  "experiment_name": "custom_ab_test",
  "baseline": {
    "name": "baseline",
    "search": {
      "top_k": 5,
      "search_mode": "hybrid",
      "chunk_size": 800,
      "chunk_overlap": 100,
      "enable_reranker": true,
      "reranker_top_k": 5
    },
    "reflection": {
      "enable_reflection": false
    }
  },
  "variants": [
    {
      "name": "optimized_v1",
      "search": {
        "top_k": 8,
        "search_mode": "hybrid",
        "chunk_size": 800,
        "chunk_overlap": 100,
        "enable_reranker": true,
        "reranker_top_k": 8
      },
      "reflection": {
        "enable_reflection": false
      }
    },
    {
      "name": "with_reflection",
      "search": {
        "top_k": 5,
        "search_mode": "hybrid",
        "chunk_size": 800,
        "chunk_overlap": 100,
        "enable_reranker": true,
        "reranker_top_k": 5
      },
      "reflection": {
        "enable_reflection": true,
        "max_iterations": 2,
        "reflection_prompt": "核对证据、条件限定和引用，只修正已确认的问题；没有问题时保留原答案。"
      }
    }
  ],
  "test_dataset_path": "app/evaluation/test_dataset_30.json",
  "max_concurrency": 5,
  "timeout_seconds": 120
}
