# 环境变量模板 — 复制为 .env 并按需修改
# 复制本文件为 backend/.env 或 deploy/.env 后使用

# ===== 文档解析沙箱 Runner =====
# 本地开发可不设置，默认使用项目 deploy/.local/sandbox.sock。
# 生产环境在 Runner 的 systemd 单元和 backend/.env 中同时设为绝对路径：
# SANDBOX_RUNNER_SOCKET=/run/career/sandbox.sock

# Runner 使用独立 OS 账号（生产环境必须设置）
# 后端账号需要加入专用 socket 组，但不得加入 Docker 组。
# 示例: SANDBOX_RUNNER_GROUP=career-sandbox
# SANDBOX_RUNNER_GROUP=career-sandbox

# 是否启用文档解析沙箱（默认启用）
# 关闭时上传文件会直接失败，不会回退到后端解析
SANDBOX_DOCUMENTS_ENABLED=true

# 审计日志路径（默认 deploy/.local/audit.log）
# SANDBOX_AUDIT_LOG=/var/log/career/sandbox-audit.log

# ===== MCP 容器 =====
MCP_IMAGE=career-mcp:1
MCP_ENABLED=true
MCP_FILES_ENABLED=true
MCP_DATABASE_ENABLED=true
MCP_STARTUP_TIMEOUT=30.0
MCP_RESEARCH_TIMEOUT=45.0
MCP_RESEARCH_MAX_STEPS=6

# 搜索服务的 Unix socket 卷名（需与 docker-compose.mcp.yml 一致）
MCP_SEARCH_SOCKET_VOLUME=career-mcp-search-socket

# ===== 后端配置 =====
DATABASE_URL=postgresql+asyncpg://career_user:career_password@localhost:5432/career_db
REDIS_URL=redis://127.0.0.1:6379/0
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_CHAT_MODEL=qwen3.8-flash
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=career_minio
MINIO_SECRET_KEY=career_minio_password

# 文档解析限制
MAX_PARSED_DOCUMENT_CHARS=200000
MAX_UPLOAD_SIZE_MB=20
